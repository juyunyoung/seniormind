rules_version = '2';
// 클라이언트(앱) 직접 접근 전면 차단. 모든 읽기·쓰기는 서버(Cloud Run, Admin SDK)만 한다.
// 근거: 팀 문서 DB 정의 v0.3 6장 "클라이언트 직접 접근 전면 차단 + Admin SDK만 허용".
// Admin SDK는 보안 규칙을 거치지 않으므로 서버 동작에는 영향이 없다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
